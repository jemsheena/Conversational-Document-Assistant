# =============================================================================
# Conversational Document Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Choose your LLM provider: groq, openai, huggingface, local, or gemini
LLM_PROVIDER=groq
BACKEND_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlZjMxZDViOS0zOTY3LTQ0MzUtYjc1NS1hY2M2MThiMTJiZjYiLCJuYW1lIjoia3JteWp1eSIsImVtYWlsIjoiamVtc2hlZW5hOTlAZ21haWwuY29tIiwicm9sZSI6InVzZXIiLCJleHAiOjE3ODI5MTM4NTZ9.dWq2CdWl--TZI3dZN3jfHYsif731f32L1pl41H0VEyk
# -----------------------------------------------------------------------------
# Groq Configuration (Recommended - Fast & Free Tier Available)
# -----------------------------------------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Available Groq Models:
# - llama-3.3-70b-versatile (recommended, 128K context)
# - llama-3.1-70b-versatile (128K context)
# - mixtral-8x7b-32768 (32K context, ultra-fast)
# - gemma2-9b-it (8K context, lightweight)

# -----------------------------------------------------------------------------
# Gemini Configuration
# -----------------------------------------------------------------------------
# Set GEMINI_USE_VERTEXAI=true to use Vertex AI with application default credentials
# or leave it false and use GEMINI_API_KEY for Gemini API key mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_VERTEXAI=false
GEMINI_AGENT_MODE=true
GEMINI_AGENT_MAX_STEPS=3
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Hugging Face Configuration (Free Alternative)
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=gpt2

# Popular HF models for text generation:
# - gpt2 (simple, reliable)
# - distilgpt2 (faster, smaller)
# - HuggingFaceH4/zephyr-7b-beta (better quality, slower)

# -----------------------------------------------------------------------------
# Local LLM Configuration (Ollama, LM Studio, etc.)
# -----------------------------------------------------------------------------
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:0.5b

# Popular Ollama models:
# - qwen2.5:0.5b (smallest, ~0.5GB)
# - llama3.2:1b (1GB)
# - phi3:mini (3.8GB)
# - llama3.1:8b (4.7GB)

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# -----------------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Vector Store Configuration
# Options: "faiss" (local, single-instance) or "pgvector" (distributed, AlloyDB)
# Default: faiss (no additional dependencies)
# Learn more: https://github.com/jemsheena/Conversational-Document-Assistant/docs/alloydb-pgvector.md
# -----------------------------------------------------------------------------
VECTOR_STORE=faiss

# When using pgvector (AlloyDB / Cloud SQL):
#   VECTOR_STORE=pgvector
#   Install: pip install pgvector
#   DATABASE_URL must point to PostgreSQL 13+ instance with pgvector extension
#   Run migrations: alembic upgrade head

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
DATA_DIR=./data

# PDF storage: "local" (disk, default for dev) or "s3" (AWS, for production)
STORAGE_BACKEND=local

# AWS S3 — only used when STORAGE_BACKEND=s3
# EC2 setup (no access keys in .env):
#   1. IAM → Roles → Create role → EC2 → attach AmazonS3FullAccess → name: ec2-s3-pdf-access
#   2. EC2 → instance → Actions → Security → Modify IAM role → select ec2-s3-pdf-access
# On EC2, copy this block into .env and set STORAGE_BACKEND=s3:
# STORAGE_BACKEND=s3
AWS_REGION=eu-north-1
S3_BUCKET=conversational-doc-assistant-pdfs
S3_PREFIX=pdfs/
# AWS_ACCESS_KEY_ID=      # optional — local dev only, when testing against real S3
# AWS_SECRET_ACCESS_KEY=  # optional

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Change this in production!
JWT_SECRET=change-this-in-production-to-a-secure-random-string

# Backend auth token for n8n automation (JWT access token from app login)

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# RAG Configuration (Advanced)
# -----------------------------------------------------------------------------
DEFAULT_K=12
DEFAULT_RERANK_K=6
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120
MIN_RETRIEVAL_SCORE=0.1

# -----------------------------------------------------------------------------
# Caching Configuration
# -----------------------------------------------------------------------------
CACHE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Token Limits & Cost Protection
# -----------------------------------------------------------------------------
MAX_CONTEXT_TOKENS=8000

# Max daily tokens per user (rough estimate: 1M tokens ≈ $0.05-0.27 on Groq)
# Default: 1,000,000 tokens/day per user (~$2-5/day per user)
# Set to lower values for strict budgets (e.g., 100,000 for ~$0.25/day)
MAX_DAILY_TOKENS_PER_USER=1000000

# Warn when user reaches this % of daily budget (50 = warn at 50%)
DAILY_TOKEN_WARNING_THRESHOLD_PERCENT=80

# -----------------------------------------------------------------------------
# Rate Limiting (Abuse Prevention)
# -----------------------------------------------------------------------------
# Max chat requests per user per minute (prevents spam/DoS)
CHAT_RATE_LIMIT=10

# Max file size for PDF upload (MB)
INGEST_MAX_SIZE_MB=50

# -----------------------------------------------------------------------------
# EC2 only (optional) — for pulling private GHCR images on the server
# Never commit a real token; set this only in the server's local .env
# -----------------------------------------------------------------------------
# GHCR_TOKEN=
# REPO_OWNER=your-github-username

# -----------------------------------------------------------------------------
# GitHub Actions CI/CD deploy (optional)
# Add repository secrets: EC2_HOST, EC2_USER, EC2_SSH_KEY
# Add repository variable: EC2_DEPLOY_ENABLED=true
# -----------------------------------------------------------------------------
